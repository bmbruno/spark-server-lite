@model SparkServerLite.ViewModels.Seo.SitemapViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Sitemap";
}

<h2>@ViewData["Title"]</h2>

<form method="POST" action="/seo/rebuildsitemap">
    <div class="row center">
        <input type="submit" value="Rebuild Sitemap" />
    </div>
</form>
    
<table class="report">
    <thead>
        <tr>
            <th>Page</th>
        </tr>
    </thead>
    <tbody>
        @foreach (string pageURL in Model.Sitemap)
        {
            <tr>
                <td>@pageURL</td>
            </tr>
        }
    </tbody>
</table>