@model SparkServerLite.ViewModels.Seo.SitemapViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Sitemap";
}

<h2>@ViewData["Title"]</h2>

<form method="POST" action="/seo/rebuildsitemap">
    <div class="row center">
        <input type="submit" value="Rebuild Sitemap" class="btn primary" />
    </div>
</form>

<div style="background-color: #FFF; border-radius: 8px; padding: 1em; font-family: monospace; text-align: left;">
    @foreach (string line in Model.Sitemap)
    {
        @line <br/>
    }
</div>